{
  "expo": {
    "name": "Aquasense",
    "slug": "aquasense-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aquasense",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aquasense.monitoring"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.aquasense.monitoring"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-nitro/app.plugin.js",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Aquasense uses Bluetooth to configure the ESP32 Wi-Fi connection."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
